# production | staging | development. Anything but production => noindex + robots Disallow: /
SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side base of banovit-cms storefront API (stage2: http://127.0.0.1:8111/api/storefront/v1)
STOREFRONT_API_URL=http://127.0.0.1:8000/api/storefront/v1
# Same value as STOREFRONT_INTERNAL_TOKEN in banovit-cms .env
STOREFRONT_INTERNAL_TOKEN=
# HMAC secret shared with the CMS revalidation job
REVALIDATE_SECRET=
